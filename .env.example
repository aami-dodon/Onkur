# Root environment for docker compose (copy to .env).
# App settings live in backend/.env and frontend/.env; this file only
# configures the compose stack and the Cloudflare tunnel.

# Every request behind one port; the tunnel publishes it.
GATEWAY_PORT=1012

# Token of the named Cloudflare tunnel that publishes the app at
# https://onkur.dodon.in. Copy it from Zero Trust > Networks > Tunnels >
# <tunnel> > Configure. Empty: the tunnel container exits and the rest of
# the stack runs.
CLOUDFLARE_TUNNEL_TOKEN=
